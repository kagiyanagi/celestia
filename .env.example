# AniList public metadata works without credentials.
ANILIST_GRAPHQL_ENDPOINT=https://graphql.anilist.co
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=http://localhost:3000/api/auth/callback/anilist
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional airing + dub timetable enrichment (exact dub episode counts and
# arrival times). Free token: animeschedule.net -> Settings -> API.
ANIMESCHEDULE_API_BASE_URL=https://animeschedule.net/api/v3
ANIMESCHEDULE_API_TOKEN=

# Optional episode stills for long-running series (e.g. One Piece) where
# TVDB coverage is sparse. Free key: themoviedb.org -> Settings -> API.
# Accepts either a v3 API key or a v4 read access token.
TMDB_API_KEY=

# Required in production: encrypts stored OAuth tokens at rest.
# Generate with: openssl rand -hex 32
APP_SECRET=

# Optional: protects /api/cron/cleanup. Vercel cron sends it automatically.
CRON_SECRET=

# Durable app state storage (Postgres). Required in production — the JSON
# file fallback does not persist on serverless hosts.
DATABASE_URL=

# Streaming is supported through a swappable adapter. No endpoint ships with
# the app — bring your own and configure it entirely here. Nothing is sent to a
# provider unless you set one of the variables below.
#
# STREAMING_PROVIDER_KIND selects how a provider is resolved:
#   "search" (default) — STREAMING_PROVIDER_URL is an API base; the app searches
#     it by title and verifies the episode count before trusting a match.
#   "embed" — STREAMING_PROVIDER_URL is an iframe URL template with {id},
#     {episode}, and {audio} placeholders, resolved directly from the AniList id
#     (e.g. https://your-host/your-path/{id}/{episode}/{audio}).
#
# Iframes default to referrerPolicy "no-referrer". An embed host that only
# resolves when it receives a Referer can opt in via STREAMING_PROVIDER_REFERRER_POLICY
# (single) or a per-entry "referrerPolicy" (multi). Allowed: no-referrer, origin,
# origin-when-cross-origin, strict-origin-when-cross-origin, unsafe-url.
STREAMING_PROVIDER_URL=
STREAMING_PROVIDER_LABEL="Custom Provider"
STREAMING_PROVIDER_ID=custom
# STREAMING_PROVIDER_KIND=search
# STREAMING_PROVIDER_REFERRER_POLICY=origin

# Optional multi-server setup. When this is set, it takes priority over the
# single STREAMING_PROVIDER_* values above. Each entry may set "kind" to
# "search" or "embed" (see above) and an optional "referrerPolicy"; embed
# entries use a {id}/{episode}/{audio} URL template in "url".
# STREAMING_PROVIDERS='[
#   {"id":"server-a","label":"Server A","url":"https://server-a.example.com","priority":10},
#   {"id":"server-b","label":"Server B","url":"https://server-b.example.com/{id}/{episode}/{audio}","kind":"embed","referrerPolicy":"origin","priority":20}
# ]'
